# Local dev: `neon deploy` / `neon env pull` writes the Neon-managed values below
# into .env.local. Add the rest by hand. On Vercel, add every value under
# Settings → Environment Variables (Production and Preview).

# --- Neon-managed (written by `neon deploy` / `neon env pull`) ---
# Lakebase Postgres: pooled URL for the app, direct URL for migrations
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Neon Object Storage (S3-compatible; the AWS SDK reads these names)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
# Neon Realtime (beta)
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=

# --- App config (not written by Neon) ---
# 32+ characters. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
# Browser copy of the Realtime URL (Next.js expands $VAR in env files)
NEXT_PUBLIC_NEON_REALTIME_URL=$NEON_REALTIME_URL
# Set to neon-http only where outbound TCP to Postgres is blocked (e.g. the
# Claude Code cloud sandbox). Leave unset on Vercel.
DATABASE_DRIVER=

# --- AI and import (milestone 5) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR=apify/instagram-scraper
APIFY_TIKTOK_ACTOR=maximedupre/tiktok-video-downloader

# --- App ---
APP_URL=https://mealprepandplanning.vercel.app
