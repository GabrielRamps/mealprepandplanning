# Copy to .env.local for development and add each value in Vercel → Settings → Environment Variables.
# See docs/PRD.md section 9.3.

# Neon Postgres
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Auth (managed Better Auth)
NEON_AUTH_BASE_URL=
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Neon Object Storage (S3-compatible) — confirm exact names in the Neon console
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
BUCKET_PHOTOS=recipe-photos
BUCKET_IMPORTS=imports

# AI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Apify (video downloads)
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR=apify/instagram-scraper
APIFY_TIKTOK_ACTOR=maximedupre/tiktok-video-downloader

# App
APP_URL=https://mealprepandplanning.vercel.app
